# Copy to .env and fill in before running `npm run seed` / `npm start`.

# Path to the SQLite database file (created automatically if missing).
DB_PATH=./data/app.db

# Secret used to sign JWT session tokens. Use a long random string in real deployments.
JWT_SECRET=change-me-to-a-long-random-string

# Initial super admin account, created once by `npm run seed`.
# Leave SUPERADMIN_PASSWORD unset to have the seed script generate a random one and print it.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=

PORT=8787
